@page "/"
@using IBEBarcode.Core
@using IBEBarcode.Core.Encoders
@using IBEBarcode.Localization
@using IBEBarcode.Printing
@using IBEBarcode.Rendering
@using IBEBarcode.Templates
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject LanguageState LanguageState

<PageTitle>@S.AppTitle</PageTitle>

<h1>@S.AppTitle</h1>

<div class="mb-3">
    <label>@S.Language</label>
    <select class="form-select" style="max-width:240px" value="@_selectedLanguageTag" @onchange="OnLanguageChanged">
        @foreach (var language in AppLanguageExtensions.AllLanguages)
        {
            <option value="@language.CultureTag()" selected="@(language == LanguageState.Current)">@language.DisplayName()</option>
        }
    </select>
</div>

<div class="mb-3">
    <label>@S.ValueToEncode</label>
    <input class="form-control" @bind="InputText" @bind:event="oninput" />
</div>

<div class="mb-3">
    <label>@S.Symbology.Replace("_", "")</label>
    <select class="form-select" @bind="SelectedSymbology">
        @foreach (var symbology in AvailableSymbologies)
        {
            <option value="@symbology">@symbology</option>
        }
    </select>
</div>

@if (ErrorMessage is not null)
{
    <p style="color:red">@ErrorMessage</p>
}

@if (PreviewImageDataUri is not null)
{
    <img src="@PreviewImageDataUri" style="max-width:600px;border:1px solid gray;padding:8px" />
}

<div class="mb-3" style="margin-top:12px">
    <label>@S.PaperTemplate</label>
    <select class="form-select" @bind="SelectedTemplateCode">
        @foreach (var t in AvailableTemplates)
        {
            <option value="@t.Code">@t.ToString()</option>
        }
    </select>
</div>

<button class="btn btn-primary" @onclick="GenerateLabelSheetPdf">@S.GenerateLabelSheetPdfButton</button>

@if (PdfErrorMessage is not null)
{
    <p style="color:red">@PdfErrorMessage</p>
}

@if (PdfDataUri is not null)
{
    <p><a href="@PdfDataUri" download="label-sheet.pdf">@S.DownloadLabelSheetPdf</a> (@PdfByteCount bytes)</p>
}

@code {
    private string _inputText = "HELLO123";
    private SupportedSymbology _selectedSymbology = SupportedSymbology.Code39;
    private string _selectedLanguageTag = "en";
    private bool _languageInitialized;

    private StringTable S { get; set; } = Strings.Get(AppLanguage.English);

    private string? ErrorMessage;
    private string? PreviewImageDataUri;
    private byte[]? _lastPngBytes;
    private string _selectedTemplateCode = "5160";
    private string? PdfErrorMessage;
    private string? PdfDataUri;
    private int PdfByteCount;

    private string SelectedTemplateCode
    {
        get => _selectedTemplateCode;
        set => _selectedTemplateCode = value;
    }

    public IReadOnlyList<SupportedSymbology> AvailableSymbologies { get; } =
        Enum.GetValues<SupportedSymbology>();

    public IReadOnlyList<PaperTemplate> AvailableTemplates { get; } =
        PaperTemplateCatalog.AllTemplates;

    private string InputText
    {
        get => _inputText;
        set { _inputText = value; Regenerate(); }
    }

    private SupportedSymbology SelectedSymbology
    {
        get => _selectedSymbology;
        set { _selectedSymbology = value; Regenerate(); }
    }

    private async Task OnLanguageChanged(ChangeEventArgs args)
    {
        var tag = args.Value?.ToString() ?? "en";
        SetLanguage(AppLanguageExtensions.FromCultureName(tag));
        await PersistLanguageAsync();
    }

    private void SetLanguage(AppLanguage language)
    {
        // Publish first: the sidebar and the About link in the layout listen for this.
        LanguageState.Set(language);
        _selectedLanguageTag = language.CultureTag();
        S = Strings.Get(language);
        _ = ApplyDocumentLanguageAsync();
        Regenerate();
    }

    /// <summary>First render: ?lang=… wins, then the saved choice, then the browser's
    /// preferred languages, then English. JS interop is available only now.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _languageInitialized)
        {
            return;
        }

        _languageInitialized = true;

        AppLanguage language;
        var queryTag = GetQueryLanguage();

        if (queryTag is not null)
        {
            language = AppLanguageExtensions.FromCultureName(queryTag);
        }
        else
        {
            var stored = await TryGetStoredLanguageAsync();
            language = stored is not null
                ? AppLanguageExtensions.FromCultureName(stored)
                : AppLanguageExtensions.FromPreferredLanguages(await TryGetPreferredLanguagesAsync());
        }

        // The layout components start on English too, so only a real change is worth publishing.
        if (language != LanguageState.Current)
        {
            SetLanguage(language);
            StateHasChanged();
        }
    }

    private string? GetQueryLanguage()
    {
        try
        {
            var uri = new Uri(Navigation.Uri);
            return System.Web.HttpUtility.ParseQueryString(uri.Query)["lang"];
        }
        catch
        {
            return null;
        }
    }

    /// <summary>The saved language, or null when storage is unavailable (private mode) or
    /// the helper script has not loaded. Interop in the first render is best-effort only.</summary>
    private async Task<string?> TryGetStoredLanguageAsync()
    {
        try
        {
            return await JS.InvokeAsync<string?>("ibeLang.get", "lang");
        }
        catch
        {
            return null;
        }
    }

    private async Task<string[]?> TryGetPreferredLanguagesAsync()
    {
        try
        {
            return await JS.InvokeAsync<string[]>("ibeLang.preferredLanguages");
        }
        catch
        {
            return null;
        }
    }

    private async Task PersistLanguageAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("ibeLang.set", "lang", LanguageState.Current.CultureTag());
        }
        catch
        {
            // Storage unavailable (private mode etc.) — language still applies for the session.
        }
    }

    private async Task ApplyDocumentLanguageAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("ibeLang.setDocumentLang", LanguageState.Current.CultureTag());
        }
        catch
        {
        }
    }

    private void GenerateLabelSheetPdf()
    {
        PdfErrorMessage = null;
        PdfDataUri = null;

        if (_lastPngBytes is null)
        {
            PdfErrorMessage = S.GenerateValidBarcodeFirst;
            return;
        }

        var template = AvailableTemplates.FirstOrDefault(t => t.Code == SelectedTemplateCode);

        if (template is null)
        {
            PdfErrorMessage = S.SelectTemplateFirst;
            return;
        }

        try
        {
            var images = new List<byte[]>();

            for (var i = 0; i < template.LabelCount; i++)
            {
                images.Add(_lastPngBytes);
            }

            var pdfBytes = LabelSheetPdfGenerator.Generate(template, images);
            PdfByteCount = pdfBytes.Length;
            PdfDataUri = $"data:application/pdf;base64,{Convert.ToBase64String(pdfBytes)}";
        }
        catch (Exception ex)
        {
            PdfErrorMessage = S.Format(S.PdfGenerationFailed, $"{ex.GetType().Name}: {ex.Message}");
        }
    }

    protected override void OnInitialized() => Regenerate();

    private void Regenerate()
    {
        ErrorMessage = null;
        PreviewImageDataUri = null;
        _lastPngBytes = null;

        if (string.IsNullOrEmpty(InputText))
        {
            ErrorMessage = S.EnterValueToEncode;
            return;
        }

        try
        {
            byte[] pngBytes;

            if (SelectedSymbology is SupportedSymbology.QrCode or SupportedSymbology.DataMatrix or SupportedSymbology.Pdf417 or SupportedSymbology.Aztec)
            {
                IMatrixBarcodeEncoder matrixEncoder = SelectedSymbology switch
                {
                    SupportedSymbology.QrCode => new QrEncoder(),
                    SupportedSymbology.DataMatrix => new DataMatrixEncoder(),
                    SupportedSymbology.Pdf417 => new Pdf417Encoder(),
                    _ => new AztecEncoder(),
                };

                if (!matrixEncoder.TryEncode(InputText, out var matrix, out var error))
                {
                    ErrorMessage = error;
                    return;
                }

                pngBytes = MatrixRenderer.RenderToPng(matrix!, new MatrixRenderOptions { ModuleSizePixels = 8, QuietZoneModules = 4 });
            }
            else if (SelectedSymbology == SupportedSymbology.Postnet)
            {
                var postnetEncoder = new PostnetEncoder();

                if (!postnetEncoder.TryEncode(InputText, out var heightPattern, out var error))
                {
                    ErrorMessage = error;
                    return;
                }

                pngBytes = HeightBarRenderer.RenderToPng(heightPattern!, new HeightBarRenderOptions { BarWidthPixels = 3, GapPixels = 2 });
            }
            else
            {
                IBarcodeEncoder encoder = SelectedSymbology switch
                {
                    SupportedSymbology.Code39 => new Code39Encoder(),
                    SupportedSymbology.Codabar => new CodabarEncoder(),
                    SupportedSymbology.Interleaved2Of5 => new Interleaved2Of5Encoder(),
                    SupportedSymbology.MsiPlessey => new MsiPlesseyEncoder(),
                    SupportedSymbology.Code93 => new Code93Encoder(),
                    SupportedSymbology.Code39Extended => new ExtendedCode39Encoder(),
                    SupportedSymbology.Code128 => new Code128Encoder(Code128Set.Auto),
                    SupportedSymbology.Ean13 => new Ean13Encoder(),
                    SupportedSymbology.Ean8 => new Ean8Encoder(),
                    SupportedSymbology.UpcA => new UpcAEncoder(),
                    SupportedSymbology.UpcE => new UpcEEncoder(),
                    SupportedSymbology.Isbn => new IsbnEncoder(),
                    SupportedSymbology.Gs1_128 => new Gs1_128Encoder(),
                    SupportedSymbology.Upc2DigitSupplement => new Upc2DigitSupplementEncoder(),
                    SupportedSymbology.Upc5DigitSupplement => new Upc5DigitSupplementEncoder(),
                    _ => throw new ArgumentOutOfRangeException(),
                };

                if (!encoder.TryEncode(InputText, out var pattern, out var error))
                {
                    ErrorMessage = error;
                    return;
                }

                pngBytes = BarcodeRenderer.RenderToPng(pattern!, new BarcodeRenderOptions { ModuleWidthPixels = 2, QuietZoneModules = 10, BarHeightPixels = 80, ShowHumanReadableText = true, TextHeightPixels = 24 });
            }

            _lastPngBytes = pngBytes;
            PreviewImageDataUri = $"data:image/png;base64,{Convert.ToBase64String(pngBytes)}";
        }
        catch (Exception ex)
        {
            ErrorMessage = S.Format(S.UnexpectedError, ex.Message);
        }
    }

    public enum SupportedSymbology
    {
        Code39,
        Codabar,
        Interleaved2Of5,
        MsiPlessey,
        Code93,
        Code39Extended,
        Code128,
        Ean13,
        Ean8,
        UpcA,
        UpcE,
        Isbn,
        QrCode,
        Postnet,
        DataMatrix,
        Pdf417,
        Aztec,
        Gs1_128,
        Upc2DigitSupplement,
        Upc5DigitSupplement,
    }
}
